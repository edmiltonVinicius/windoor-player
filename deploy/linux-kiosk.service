[Unit]
Description=Totem Kiosk Browser
After=graphical.target network-online.target
Wants=network-online.target

[Service]
Environment=DISPLAY=:0
ExecStart=/usr/bin/chromium --kiosk --noerrdialogs --disable-infobars --disable-session-crashed-bubble --app=https://totem.seudominio.com/?totem=LOJA1234
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
